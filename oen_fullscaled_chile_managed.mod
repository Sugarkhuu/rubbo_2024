// =========================================================================
// Open-Economy Production-Network New Keynesian Model
// Rubbo (2024) extended to a Small Open Economy -- FULL-NATIVE-RESOLUTION
// CHILE DATA CALIBRATION, N=12 sectors
//
// AUTO-GENERATED by data_calibration/generate_mod.py from
// chile_calibration_full_results.json -- do not hand-edit; edit the
// calibration script or generator and regenerate instead.
//
// Source: Banco Central de Chile, Cuadros 12x12, ano base 2008 (precios basicos) (FULL 12-activity resolution, no 3-sector aggregation)
//
// Full-resolution generalization of open_economy_network_chile.mod (which
// hand-derives (I-Omega^H)^-1 via a 3x3 cofactor formula written as scalar
// Dynare parameter algebra -- infeasible at N=12). Instead:
//   - LAMBDA_D_i (Domar/domestic-supplier centrality) and WDC_i (DC-index
//     weights) are computed in Python (numpy.linalg.inv) and written in here
//     as plain calibrated CONSTANTS, not derived via in-Dynare matrix
//     inversion -- see data_calibration/full_calibration_common.py.
//   - The steady state is solved by soe_ss_solve_dense_N.m /
//     soe_ss_resid_dense_N.m, ordinary MATLAB matrix algebra (backslash
//     solves), generalizing soe_ss_solve_dense.m/soe_ss_resid_dense.m from
//     3x3 to NxN.
//   - DELTA_i (raw Calvo reset probability) is NOT identifiable from IO data
//     at any resolution; each raw sector inherits its macro-category's
//     (Resource/Manufacturing/Services) literature default (Dhyne et al.
//     2005/ECB IPN), via a category concordance kept ONLY for this purpose
//     -- see build_chile_calibration.py's build_full().
//
// REGIMES (set via -DREGIME=... on the command line):
//   float    Taylor rule targets the DC index (benchmark)
//   peg      exchange rate fixed, S_t = 1
//   managed  Taylor rule + partial FX stabilisation
//   cpi_it   strict CPI (PIC) inflation targeting
//   ppi_it   strict PPI/domestic-bundle (PH) inflation targeting
// =========================================================================

@#ifndef REGIME
@#define REGIME = "managed"
@#endif

// -------------------------------------------------------------------------
// VARIABLES
// -------------------------------------------------------------------------
var
  Y1 L1 P1 PI1 MC1 PSTAR1 X1_1 X2_1 A1 y_gap1
  Y2 L2 P2 PI2 MC2 PSTAR2 X1_2 X2_2 A2 y_gap2
  Y3 L3 P3 PI3 MC3 PSTAR3 X1_3 X2_3 A3 y_gap3
  Y4 L4 P4 PI4 MC4 PSTAR4 X1_4 X2_4 A4 y_gap4
  Y5 L5 P5 PI5 MC5 PSTAR5 X1_5 X2_5 A5 y_gap5
  Y6 L6 P6 PI6 MC6 PSTAR6 X1_6 X2_6 A6 y_gap6
  Y7 L7 P7 PI7 MC7 PSTAR7 X1_7 X2_7 A7 y_gap7
  Y8 L8 P8 PI8 MC8 PSTAR8 X1_8 X2_8 A8 y_gap8
  Y9 L9 P9 PI9 MC9 PSTAR9 X1_9 X2_9 A9 y_gap9
  Y10 L10 P10 PI10 MC10 PSTAR10 X1_10 X2_10 A10 y_gap10
  Y11 L11 P11 PI11 MC11 PSTAR11 X1_11 X2_11 A11 y_gap11
  Y12 L12 P12 PI12 MC12 PSTAR12 X1_12 X2_12 A12 y_gap12
  C CH CF PH PC PIC Ltot W S PF PFH BSTAR I EX IM DSTAR PX RP piDC y_gap GDP
;

// -------------------------------------------------------------------------
// EXOGENOUS SHOCKS
// -------------------------------------------------------------------------
varexo eps_a1 eps_a2 eps_a3 eps_a4 eps_a5 eps_a6 eps_a7 eps_a8 eps_a9 eps_a10 eps_a11 eps_a12 eps_pF eps_D eps_pX eps_rp;

// -------------------------------------------------------------------------
// PARAMETERS
// -------------------------------------------------------------------------
parameters
  ALPHA1 OF1 BH1 DELTA1 DHAT1 LAMBDA_D1 WDC1
  ALPHA2 OF2 BH2 DELTA2 DHAT2 LAMBDA_D2 WDC2
  ALPHA3 OF3 BH3 DELTA3 DHAT3 LAMBDA_D3 WDC3
  ALPHA4 OF4 BH4 DELTA4 DHAT4 LAMBDA_D4 WDC4
  ALPHA5 OF5 BH5 DELTA5 DHAT5 LAMBDA_D5 WDC5
  ALPHA6 OF6 BH6 DELTA6 DHAT6 LAMBDA_D6 WDC6
  ALPHA7 OF7 BH7 DELTA7 DHAT7 LAMBDA_D7 WDC7
  ALPHA8 OF8 BH8 DELTA8 DHAT8 LAMBDA_D8 WDC8
  ALPHA9 OF9 BH9 DELTA9 DHAT9 LAMBDA_D9 WDC9
  ALPHA10 OF10 BH10 DELTA10 DHAT10 LAMBDA_D10 WDC10
  ALPHA11 OF11 BH11 DELTA11 DHAT11 LAMBDA_D11 WDC11
  ALPHA12 OF12 BH12 DELTA12 DHAT12 LAMBDA_D12 WDC12
  OH1_1 OH1_2 OH1_3 OH1_4 OH1_5 OH1_6 OH1_7 OH1_8 OH1_9 OH1_10 OH1_11 OH1_12
  OH2_1 OH2_2 OH2_3 OH2_4 OH2_5 OH2_6 OH2_7 OH2_8 OH2_9 OH2_10 OH2_11 OH2_12
  OH3_1 OH3_2 OH3_3 OH3_4 OH3_5 OH3_6 OH3_7 OH3_8 OH3_9 OH3_10 OH3_11 OH3_12
  OH4_1 OH4_2 OH4_3 OH4_4 OH4_5 OH4_6 OH4_7 OH4_8 OH4_9 OH4_10 OH4_11 OH4_12
  OH5_1 OH5_2 OH5_3 OH5_4 OH5_5 OH5_6 OH5_7 OH5_8 OH5_9 OH5_10 OH5_11 OH5_12
  OH6_1 OH6_2 OH6_3 OH6_4 OH6_5 OH6_6 OH6_7 OH6_8 OH6_9 OH6_10 OH6_11 OH6_12
  OH7_1 OH7_2 OH7_3 OH7_4 OH7_5 OH7_6 OH7_7 OH7_8 OH7_9 OH7_10 OH7_11 OH7_12
  OH8_1 OH8_2 OH8_3 OH8_4 OH8_5 OH8_6 OH8_7 OH8_8 OH8_9 OH8_10 OH8_11 OH8_12
  OH9_1 OH9_2 OH9_3 OH9_4 OH9_5 OH9_6 OH9_7 OH9_8 OH9_9 OH9_10 OH9_11 OH9_12
  OH10_1 OH10_2 OH10_3 OH10_4 OH10_5 OH10_6 OH10_7 OH10_8 OH10_9 OH10_10 OH10_11 OH10_12
  OH11_1 OH11_2 OH11_3 OH11_4 OH11_5 OH11_6 OH11_7 OH11_8 OH11_9 OH11_10 OH11_11 OH11_12
  OH12_1 OH12_2 OH12_3 OH12_4 OH12_5 OH12_6 OH12_7 OH12_8 OH12_9 OH12_10 OH12_11 OH12_12
  BETA GAMMA VARPHI EPS BF_TOT OMEGA ETA PSI THETA_S KAPEX_SCALE BSTARBAR ISTAR PHI_PI PHI_Y PHI_S RHO_A RHO_PF RHO_D RHO_PX RHO_RP
;

