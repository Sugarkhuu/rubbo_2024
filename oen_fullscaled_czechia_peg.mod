Y78 = BH78*PH*CH/P78 + (OH1_78*MC1*Y1 + OH2_78*MC2*Y2 + OH3_78*MC3*Y3 + OH4_78*MC4*Y4 + OH5_78*MC5*Y5 + OH6_78*MC6*Y6 + OH7_78*MC7*Y7 + OH8_78*MC8*Y8 + OH9_78*MC9*Y9 + OH10_78*MC10*Y10 + OH11_78*MC11*Y11 + OH12_78*MC12*Y12 + OH13_78*MC13*Y13 + OH14_78*MC14*Y14 + OH15_78*MC15*Y15 + OH16_78*MC16*Y16 + OH17_78*MC17*Y17 + OH18_78*MC18*Y18 + OH19_78*MC19*Y19 + OH20_78*MC20*Y20 + OH21_78*MC21*Y21 + OH22_78*MC22*Y22 + OH23_78*MC23*Y23 + OH24_78*MC24*Y24 + OH25_78*MC25*Y25 + OH26_78*MC26*Y26 + OH27_78*MC27*Y27 + OH28_78*MC28*Y28 + OH29_78*MC29*Y29 + OH30_78*MC30*Y30 + OH31_78*MC31*Y31 + OH32_78*MC32*Y32 + OH33_78*MC33*Y33 + OH34_78*MC34*Y34 + OH35_78*MC35*Y35 + OH36_78*MC36*Y36 + OH37_78*MC37*Y37 + OH38_78*MC38*Y38 + OH39_78*MC39*Y39 + OH40_78*MC40*Y40 + OH41_78*MC41*Y41 + OH42_78*MC42*Y42 + OH43_78*MC43*Y43 + OH44_78*MC44*Y44 + OH45_78*MC45*Y45 + OH46_78*MC46*Y46 + OH47_78*MC47*Y47 + OH48_78*MC48*Y48 + OH49_78*MC49*Y49 + OH50_78*MC50*Y50 + OH51_78*MC51*Y51 + OH52_78*MC52*Y52 + OH53_78*MC53*Y53 + OH54_78*MC54*Y54 + OH55_78*MC55*Y55 + OH56_78*MC56*Y56 + OH57_78*MC57*Y57 + OH58_78*MC58*Y58 + OH59_78*MC59*Y59 + OH60_78*MC60*Y60 + OH61_78*MC61*Y61 + OH62_78*MC62*Y62 + OH63_78*MC63*Y63 + OH64_78*MC64*Y64 + OH65_78*MC65*Y65 + OH66_78*MC66*Y66 + OH67_78*MC67*Y67 + OH68_78*MC68*Y68 + OH69_78*MC69*Y69 + OH70_78*MC70*Y70 + OH71_78*MC71*Y71 + OH72_78*MC72*Y72 + OH73_78*MC73*Y73 + OH74_78*MC74*Y74 + OH75_78*MC75*Y75 + OH76_78*MC76*Y76 + OH77_78*MC77*Y77 + OH78_78*MC78*Y78 + OH79_78*MC79*Y79 + OH80_78*MC80*Y80 + OH81_78*MC81*Y81)/P78 + BH78*PH*EX/P78;
Y79 = BH79*PH*CH/P79 + (OH1_79*MC1*Y1 + OH2_79*MC2*Y2 + OH3_79*MC3*Y3 + OH4_79*MC4*Y4 + OH5_79*MC5*Y5 + OH6_79*MC6*Y6 + OH7_79*MC7*Y7 + OH8_79*MC8*Y8 + OH9_79*MC9*Y9 + OH10_79*MC10*Y10 + OH11_79*MC11*Y11 + OH12_79*MC12*Y12 + OH13_79*MC13*Y13 + OH14_79*MC14*Y14 + OH15_79*MC15*Y15 + OH16_79*MC16*Y16 + OH17_79*MC17*Y17 + OH18_79*MC18*Y18 + OH19_79*MC19*Y19 + OH20_79*MC20*Y20 + OH21_79*MC21*Y21 + OH22_79*MC22*Y22 + OH23_79*MC23*Y23 + OH24_79*MC24*Y24 + OH25_79*MC25*Y25 + OH26_79*MC26*Y26 + OH27_79*MC27*Y27 + OH28_79*MC28*Y28 + OH29_79*MC29*Y29 + OH30_79*MC30*Y30 + OH31_79*MC31*Y31 + OH32_79*MC32*Y32 + OH33_79*MC33*Y33 + OH34_79*MC34*Y34 + OH35_79*MC35*Y35 + OH36_79*MC36*Y36 + OH37_79*MC37*Y37 + OH38_79*MC38*Y38 + OH39_79*MC39*Y39 + OH40_79*MC40*Y40 + OH41_79*MC41*Y41 + OH42_79*MC42*Y42 + OH43_79*MC43*Y43 + OH44_79*MC44*Y44 + OH45_79*MC45*Y45 + OH46_79*MC46*Y46 + OH47_79*MC47*Y47 + OH48_79*MC48*Y48 + OH49_79*MC49*Y49 + OH50_79*MC50*Y50 + OH51_79*MC51*Y51 + OH52_79*MC52*Y52 + OH53_79*MC53*Y53 + OH54_79*MC54*Y54 + OH55_79*MC55*Y55 + OH56_79*MC56*Y56 + OH57_79*MC57*Y57 + OH58_79*MC58*Y58 + OH59_79*MC59*Y59 + OH60_79*MC60*Y60 + OH61_79*MC61*Y61 + OH62_79*MC62*Y62 + OH63_79*MC63*Y63 + OH64_79*MC64*Y64 + OH65_79*MC65*Y65 + OH66_79*MC66*Y66 + OH67_79*MC67*Y67 + OH68_79*MC68*Y68 + OH69_79*MC69*Y69 + OH70_79*MC70*Y70 + OH71_79*MC71*Y71 + OH72_79*MC72*Y72 + OH73_79*MC73*Y73 + OH74_79*MC74*Y74 + OH75_79*MC75*Y75 + OH76_79*MC76*Y76 + OH77_79*MC77*Y77 + OH78_79*MC78*Y78 + OH79_79*MC79*Y79 + OH80_79*MC80*Y80 + OH81_79*MC81*Y81)/P79 + BH79*PH*EX/P79;
Y80 = BH80*PH*CH/P80 + (OH1_80*MC1*Y1 + OH2_80*MC2*Y2 + OH3_80*MC3*Y3 + OH4_80*MC4*Y4 + OH5_80*MC5*Y5 + OH6_80*MC6*Y6 + OH7_80*MC7*Y7 + OH8_80*MC8*Y8 + OH9_80*MC9*Y9 + OH10_80*MC10*Y10 + OH11_80*MC11*Y11 + OH12_80*MC12*Y12 + OH13_80*MC13*Y13 + OH14_80*MC14*Y14 + OH15_80*MC15*Y15 + OH16_80*MC16*Y16 + OH17_80*MC17*Y17 + OH18_80*MC18*Y18 + OH19_80*MC19*Y19 + OH20_80*MC20*Y20 + OH21_80*MC21*Y21 + OH22_80*MC22*Y22 + OH23_80*MC23*Y23 + OH24_80*MC24*Y24 + OH25_80*MC25*Y25 + OH26_80*MC26*Y26 + OH27_80*MC27*Y27 + OH28_80*MC28*Y28 + OH29_80*MC29*Y29 + OH30_80*MC30*Y30 + OH31_80*MC31*Y31 + OH32_80*MC32*Y32 + OH33_80*MC33*Y33 + OH34_80*MC34*Y34 + OH35_80*MC35*Y35 + OH36_80*MC36*Y36 + OH37_80*MC37*Y37 + OH38_80*MC38*Y38 + OH39_80*MC39*Y39 + OH40_80*MC40*Y40 + OH41_80*MC41*Y41 + OH42_80*MC42*Y42 + OH43_80*MC43*Y43 + OH44_80*MC44*Y44 + OH45_80*MC45*Y45 + OH46_80*MC46*Y46 + OH47_80*MC47*Y47 + OH48_80*MC48*Y48 + OH49_80*MC49*Y49 + OH50_80*MC50*Y50 + OH51_80*MC51*Y51 + OH52_80*MC52*Y52 + OH53_80*MC53*Y53 + OH54_80*MC54*Y54 + OH55_80*MC55*Y55 + OH56_80*MC56*Y56 + OH57_80*MC57*Y57 + OH58_80*MC58*Y58 + OH59_80*MC59*Y59 + OH60_80*MC60*Y60 + OH61_80*MC61*Y61 + OH62_80*MC62*Y62 + OH63_80*MC63*Y63 + OH64_80*MC64*Y64 + OH65_80*MC65*Y65 + OH66_80*MC66*Y66 + OH67_80*MC67*Y67 + OH68_80*MC68*Y68 + OH69_80*MC69*Y69 + OH70_80*MC70*Y70 + OH71_80*MC71*Y71 + OH72_80*MC72*Y72 + OH73_80*MC73*Y73 + OH74_80*MC74*Y74 + OH75_80*MC75*Y75 + OH76_80*MC76*Y76 + OH77_80*MC77*Y77 + OH78_80*MC78*Y78 + OH79_80*MC79*Y79 + OH80_80*MC80*Y80 + OH81_80*MC81*Y81)/P80 + BH80*PH*EX/P80;
Y81 = BH81*PH*CH/P81 + (OH1_81*MC1*Y1 + OH2_81*MC2*Y2 + OH3_81*MC3*Y3 + OH4_81*MC4*Y4 + OH5_81*MC5*Y5 + OH6_81*MC6*Y6 + OH7_81*MC7*Y7 + OH8_81*MC8*Y8 + OH9_81*MC9*Y9 + OH10_81*MC10*Y10 + OH11_81*MC11*Y11 + OH12_81*MC12*Y12 + OH13_81*MC13*Y13 + OH14_81*MC14*Y14 + OH15_81*MC15*Y15 + OH16_81*MC16*Y16 + OH17_81*MC17*Y17 + OH18_81*MC18*Y18 + OH19_81*MC19*Y19 + OH20_81*MC20*Y20 + OH21_81*MC21*Y21 + OH22_81*MC22*Y22 + OH23_81*MC23*Y23 + OH24_81*MC24*Y24 + OH25_81*MC25*Y25 + OH26_81*MC26*Y26 + OH27_81*MC27*Y27 + OH28_81*MC28*Y28 + OH29_81*MC29*Y29 + OH30_81*MC30*Y30 + OH31_81*MC31*Y31 + OH32_81*MC32*Y32 + OH33_81*MC33*Y33 + OH34_81*MC34*Y34 + OH35_81*MC35*Y35 + OH36_81*MC36*Y36 + OH37_81*MC37*Y37 + OH38_81*MC38*Y38 + OH39_81*MC39*Y39 + OH40_81*MC40*Y40 + OH41_81*MC41*Y41 + OH42_81*MC42*Y42 + OH43_81*MC43*Y43 + OH44_81*MC44*Y44 + OH45_81*MC45*Y45 + OH46_81*MC46*Y46 + OH47_81*MC47*Y47 + OH48_81*MC48*Y48 + OH49_81*MC49*Y49 + OH50_81*MC50*Y50 + OH51_81*MC51*Y51 + OH52_81*MC52*Y52 + OH53_81*MC53*Y53 + OH54_81*MC54*Y54 + OH55_81*MC55*Y55 + OH56_81*MC56*Y56 + OH57_81*MC57*Y57 + OH58_81*MC58*Y58 + OH59_81*MC59*Y59 + OH60_81*MC60*Y60 + OH61_81*MC61*Y61 + OH62_81*MC62*Y62 + OH63_81*MC63*Y63 + OH64_81*MC64*Y64 + OH65_81*MC65*Y65 + OH66_81*MC66*Y66 + OH67_81*MC67*Y67 + OH68_81*MC68*Y68 + OH69_81*MC69*Y69 + OH70_81*MC70*Y70 + OH71_81*MC71*Y71 + OH72_81*MC72*Y72 + OH73_81*MC73*Y73 + OH74_81*MC74*Y74 + OH75_81*MC75*Y75 + OH76_81*MC76*Y76 + OH77_81*MC77*Y77 + OH78_81*MC78*Y78 + OH79_81*MC79*Y79 + OH80_81*MC80*Y80 + OH81_81*MC81*Y81)/P81 + BH81*PH*EX/P81;
//------------------------------------------------------------
// [5] Consumption aggregation: Cobb-Douglas domestic bundle,
//     CES nest between domestic (H) and imported (F) bundles
//------------------------------------------------------------
PH = P1^BH1 * P2^BH2 * P3^BH3 * P4^BH4 * P5^BH5 * P6^BH6 * P7^BH7 * P8^BH8 * P9^BH9 * P10^BH10 * P11^BH11 * P12^BH12 * P13^BH13 * P14^BH14 * P15^BH15 * P16^BH16 * P17^BH17 * P18^BH18 * P19^BH19 * P20^BH20 * P21^BH21 * P22^BH22 * P23^BH23 * P24^BH24 * P25^BH25 * P26^BH26 * P27^BH27 * P28^BH28 * P29^BH29 * P30^BH30 * P31^BH31 * P32^BH32 * P33^BH33 * P34^BH34 * P35^BH35 * P36^BH36 * P37^BH37 * P38^BH38 * P39^BH39 * P40^BH40 * P41^BH41 * P42^BH42 * P43^BH43 * P44^BH44 * P45^BH45 * P46^BH46 * P47^BH47 * P48^BH48 * P49^BH49 * P50^BH50 * P51^BH51 * P52^BH52 * P53^BH53 * P54^BH54 * P55^BH55 * P56^BH56 * P57^BH57 * P58^BH58 * P59^BH59 * P60^BH60 * P61^BH61 * P62^BH62 * P63^BH63 * P64^BH64 * P65^BH65 * P66^BH66 * P67^BH67 * P68^BH68 * P69^BH69 * P70^BH70 * P71^BH71 * P72^BH72 * P73^BH73 * P74^BH74 * P75^BH75 * P76^BH76 * P77^BH77 * P78^BH78 * P79^BH79 * P80^BH80 * P81^BH81;
PC = ( OMEGA*PH^(1-ETA) + (1-OMEGA)*PFH^(1-ETA) )^(1/(1-ETA));
CH = OMEGA*(PH/PC)^(-ETA)*C;
CF = (1-OMEGA)*(PFH/PC)^(-ETA)*C;
PIC = PC/PC(-1);
//------------------------------------------------------------
// [6] Household Euler equation and labour supply (nonlinear CRRA/Frisch)
//------------------------------------------------------------
C^(-GAMMA) = BETA*I*(C(+1)^(-GAMMA))/PIC(+1);
W/PC = C^GAMMA * Ltot^VARPHI;
//------------------------------------------------------------
// [7] Exchange rate block: LOP for imports, UIP with debt-elastic premium
//------------------------------------------------------------
PFH = S*PF;
I = ISTAR*(1 - PSI*(BSTAR - BSTARBAR)) * RP * S(+1)/S;
//------------------------------------------------------------
// [8] Net foreign assets: current-account identity
//------------------------------------------------------------
BSTAR = (I(-1)/PIC)*BSTAR(-1) + (PH*EX - PFH*IM)/PC;
//------------------------------------------------------------
// [9] Export demand and total import demand
//------------------------------------------------------------
EX = KAPEX_SCALE*DSTAR*PX*(PH/PFH)^(-THETA_S);
IM = CF + OF1*MC1*Y1/PFH + OF2*MC2*Y2/PFH + OF3*MC3*Y3/PFH + OF4*MC4*Y4/PFH + OF5*MC5*Y5/PFH + OF6*MC6*Y6/PFH + OF7*MC7*Y7/PFH + OF8*MC8*Y8/PFH + OF9*MC9*Y9/PFH + OF10*MC10*Y10/PFH + OF11*MC11*Y11/PFH + OF12*MC12*Y12/PFH + OF13*MC13*Y13/PFH + OF14*MC14*Y14/PFH + OF15*MC15*Y15/PFH + OF16*MC16*Y16/PFH + OF17*MC17*Y17/PFH + OF18*MC18*Y18/PFH + OF19*MC19*Y19/PFH + OF20*MC20*Y20/PFH + OF21*MC21*Y21/PFH + OF22*MC22*Y22/PFH + OF23*MC23*Y23/PFH + OF24*MC24*Y24/PFH + OF25*MC25*Y25/PFH + OF26*MC26*Y26/PFH + OF27*MC27*Y27/PFH + OF28*MC28*Y28/PFH + OF29*MC29*Y29/PFH + OF30*MC30*Y30/PFH + OF31*MC31*Y31/PFH + OF32*MC32*Y32/PFH + OF33*MC33*Y33/PFH + OF34*MC34*Y34/PFH + OF35*MC35*Y35/PFH + OF36*MC36*Y36/PFH + OF37*MC37*Y37/PFH + OF38*MC38*Y38/PFH + OF39*MC39*Y39/PFH + OF40*MC40*Y40/PFH + OF41*MC41*Y41/PFH + OF42*MC42*Y42/PFH + OF43*MC43*Y43/PFH + OF44*MC44*Y44/PFH + OF45*MC45*Y45/PFH + OF46*MC46*Y46/PFH + OF47*MC47*Y47/PFH + OF48*MC48*Y48/PFH + OF49*MC49*Y49/PFH + OF50*MC50*Y50/PFH + OF51*MC51*Y51/PFH + OF52*MC52*Y52/PFH + OF53*MC53*Y53/PFH + OF54*MC54*Y54/PFH + OF55*MC55*Y55/PFH + OF56*MC56*Y56/PFH + OF57*MC57*Y57/PFH + OF58*MC58*Y58/PFH + OF59*MC59*Y59/PFH + OF60*MC60*Y60/PFH + OF61*MC61*Y61/PFH + OF62*MC62*Y62/PFH + OF63*MC63*Y63/PFH + OF64*MC64*Y64/PFH + OF65*MC65*Y65/PFH + OF66*MC66*Y66/PFH + OF67*MC67*Y67/PFH + OF68*MC68*Y68/PFH + OF69*MC69*Y69/PFH + OF70*MC70*Y70/PFH + OF71*MC71*Y71/PFH + OF72*MC72*Y72/PFH + OF73*MC73*Y73/PFH + OF74*MC74*Y74/PFH + OF75*MC75*Y75/PFH + OF76*MC76*Y76/PFH + OF77*MC77*Y77/PFH + OF78*MC78*Y78/PFH + OF79*MC79*Y79/PFH + OF80*MC80*Y80/PFH + OF81*MC81*Y81/PFH;
//------------------------------------------------------------
// [10] Policy rule (regime-dependent)
//------------------------------------------------------------
@#if REGIME == "float"
log(I/ISTAR) = PHI_PI*piDC + PHI_Y*y_gap;
@#elseif REGIME == "peg"
S = 1;
@#elseif REGIME == "managed"
log(I/ISTAR) = PHI_PI*piDC + PHI_Y*y_gap + PHI_S*log(S);
@#elseif REGIME == "cpi_it"
log(I/ISTAR) = PHI_PI*log(PIC) + PHI_Y*y_gap;
@#elseif REGIME == "ppi_it"
log(I/ISTAR) = PHI_PI*log(PH/PH(-1)) + PHI_Y*y_gap;
@#endif
//------------------------------------------------------------
