y_gap28 = LAMBDA_D28*(log(Y28/STEADY_STATE(Y28)) - log(A28));
y_gap29 = LAMBDA_D29*(log(Y29/STEADY_STATE(Y29)) - log(A29));
y_gap30 = LAMBDA_D30*(log(Y30/STEADY_STATE(Y30)) - log(A30));
y_gap31 = LAMBDA_D31*(log(Y31/STEADY_STATE(Y31)) - log(A31));
y_gap32 = LAMBDA_D32*(log(Y32/STEADY_STATE(Y32)) - log(A32));
y_gap33 = LAMBDA_D33*(log(Y33/STEADY_STATE(Y33)) - log(A33));
y_gap = y_gap1 + y_gap2 + y_gap3 + y_gap4 + y_gap5 + y_gap6 + y_gap7 + y_gap8 + y_gap9 + y_gap10 + y_gap11 + y_gap12 + y_gap13 + y_gap14 + y_gap15 + y_gap16 + y_gap17 + y_gap18 + y_gap19 + y_gap20 + y_gap21 + y_gap22 + y_gap23 + y_gap24 + y_gap25 + y_gap26 + y_gap27 + y_gap28 + y_gap29 + y_gap30 + y_gap31 + y_gap32 + y_gap33;
//------------------------------------------------------------
// [12] Exogenous shock processes (AR(1) in logs)
//------------------------------------------------------------
log(A1) = RHO_A *log(A1(-1))  + eps_a1;
log(A2) = RHO_A *log(A2(-1))  + eps_a2;
log(A3) = RHO_A *log(A3(-1))  + eps_a3;
log(A4) = RHO_A *log(A4(-1))  + eps_a4;
log(A5) = RHO_A *log(A5(-1))  + eps_a5;
log(A6) = RHO_A *log(A6(-1))  + eps_a6;
log(A7) = RHO_A *log(A7(-1))  + eps_a7;
log(A8) = RHO_A *log(A8(-1))  + eps_a8;
log(A9) = RHO_A *log(A9(-1))  + eps_a9;
log(A10) = RHO_A *log(A10(-1))  + eps_a10;
log(A11) = RHO_A *log(A11(-1))  + eps_a11;
log(A12) = RHO_A *log(A12(-1))  + eps_a12;
log(A13) = RHO_A *log(A13(-1))  + eps_a13;
log(A14) = RHO_A *log(A14(-1))  + eps_a14;
log(A15) = RHO_A *log(A15(-1))  + eps_a15;
log(A16) = RHO_A *log(A16(-1))  + eps_a16;
log(A17) = RHO_A *log(A17(-1))  + eps_a17;
log(A18) = RHO_A *log(A18(-1))  + eps_a18;
log(A19) = RHO_A *log(A19(-1))  + eps_a19;
log(A20) = RHO_A *log(A20(-1))  + eps_a20;
log(A21) = RHO_A *log(A21(-1))  + eps_a21;
log(A22) = RHO_A *log(A22(-1))  + eps_a22;
log(A23) = RHO_A *log(A23(-1))  + eps_a23;
log(A24) = RHO_A *log(A24(-1))  + eps_a24;
log(A25) = RHO_A *log(A25(-1))  + eps_a25;
log(A26) = RHO_A *log(A26(-1))  + eps_a26;
log(A27) = RHO_A *log(A27(-1))  + eps_a27;
log(A28) = RHO_A *log(A28(-1))  + eps_a28;
log(A29) = RHO_A *log(A29(-1))  + eps_a29;
log(A30) = RHO_A *log(A30(-1))  + eps_a30;
log(A31) = RHO_A *log(A31(-1))  + eps_a31;
log(A32) = RHO_A *log(A32(-1))  + eps_a32;
log(A33) = RHO_A *log(A33(-1))  + eps_a33;
log(PF) = RHO_PF*log(PF(-1))  + eps_pF;
log(DSTAR) = RHO_D*log(DSTAR(-1)) + eps_D;
log(PX) = RHO_PX*log(PX(-1)) + eps_pX;
log(RP) = RHO_RP*log(RP(-1)) + eps_rp;
//------------------------------------------------------------
// [13] Reporting: nominal GDP = absorption + net exports
//------------------------------------------------------------
GDP = PC*C + PH*EX - PFH*IM;

end;

