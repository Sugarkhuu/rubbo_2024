Y29 = BH29*PH*CH/P29 + (OH1_29*MC1*Y1 + OH2_29*MC2*Y2 + OH3_29*MC3*Y3 + OH4_29*MC4*Y4 + OH5_29*MC5*Y5 + OH6_29*MC6*Y6 + OH7_29*MC7*Y7 + OH8_29*MC8*Y8 + OH9_29*MC9*Y9 + OH10_29*MC10*Y10 + OH11_29*MC11*Y11 + OH12_29*MC12*Y12 + OH13_29*MC13*Y13 + OH14_29*MC14*Y14 + OH15_29*MC15*Y15 + OH16_29*MC16*Y16 + OH17_29*MC17*Y17 + OH18_29*MC18*Y18 + OH19_29*MC19*Y19 + OH20_29*MC20*Y20 + OH21_29*MC21*Y21 + OH22_29*MC22*Y22 + OH23_29*MC23*Y23 + OH24_29*MC24*Y24 + OH25_29*MC25*Y25 + OH26_29*MC26*Y26 + OH27_29*MC27*Y27 + OH28_29*MC28*Y28 + OH29_29*MC29*Y29 + OH30_29*MC30*Y30 + OH31_29*MC31*Y31 + OH32_29*MC32*Y32 + OH33_29*MC33*Y33)/P29 + BH29*PH*EX/P29;
Y30 = BH30*PH*CH/P30 + (OH1_30*MC1*Y1 + OH2_30*MC2*Y2 + OH3_30*MC3*Y3 + OH4_30*MC4*Y4 + OH5_30*MC5*Y5 + OH6_30*MC6*Y6 + OH7_30*MC7*Y7 + OH8_30*MC8*Y8 + OH9_30*MC9*Y9 + OH10_30*MC10*Y10 + OH11_30*MC11*Y11 + OH12_30*MC12*Y12 + OH13_30*MC13*Y13 + OH14_30*MC14*Y14 + OH15_30*MC15*Y15 + OH16_30*MC16*Y16 + OH17_30*MC17*Y17 + OH18_30*MC18*Y18 + OH19_30*MC19*Y19 + OH20_30*MC20*Y20 + OH21_30*MC21*Y21 + OH22_30*MC22*Y22 + OH23_30*MC23*Y23 + OH24_30*MC24*Y24 + OH25_30*MC25*Y25 + OH26_30*MC26*Y26 + OH27_30*MC27*Y27 + OH28_30*MC28*Y28 + OH29_30*MC29*Y29 + OH30_30*MC30*Y30 + OH31_30*MC31*Y31 + OH32_30*MC32*Y32 + OH33_30*MC33*Y33)/P30 + BH30*PH*EX/P30;
Y31 = BH31*PH*CH/P31 + (OH1_31*MC1*Y1 + OH2_31*MC2*Y2 + OH3_31*MC3*Y3 + OH4_31*MC4*Y4 + OH5_31*MC5*Y5 + OH6_31*MC6*Y6 + OH7_31*MC7*Y7 + OH8_31*MC8*Y8 + OH9_31*MC9*Y9 + OH10_31*MC10*Y10 + OH11_31*MC11*Y11 + OH12_31*MC12*Y12 + OH13_31*MC13*Y13 + OH14_31*MC14*Y14 + OH15_31*MC15*Y15 + OH16_31*MC16*Y16 + OH17_31*MC17*Y17 + OH18_31*MC18*Y18 + OH19_31*MC19*Y19 + OH20_31*MC20*Y20 + OH21_31*MC21*Y21 + OH22_31*MC22*Y22 + OH23_31*MC23*Y23 + OH24_31*MC24*Y24 + OH25_31*MC25*Y25 + OH26_31*MC26*Y26 + OH27_31*MC27*Y27 + OH28_31*MC28*Y28 + OH29_31*MC29*Y29 + OH30_31*MC30*Y30 + OH31_31*MC31*Y31 + OH32_31*MC32*Y32 + OH33_31*MC33*Y33)/P31 + BH31*PH*EX/P31;
Y32 = BH32*PH*CH/P32 + (OH1_32*MC1*Y1 + OH2_32*MC2*Y2 + OH3_32*MC3*Y3 + OH4_32*MC4*Y4 + OH5_32*MC5*Y5 + OH6_32*MC6*Y6 + OH7_32*MC7*Y7 + OH8_32*MC8*Y8 + OH9_32*MC9*Y9 + OH10_32*MC10*Y10 + OH11_32*MC11*Y11 + OH12_32*MC12*Y12 + OH13_32*MC13*Y13 + OH14_32*MC14*Y14 + OH15_32*MC15*Y15 + OH16_32*MC16*Y16 + OH17_32*MC17*Y17 + OH18_32*MC18*Y18 + OH19_32*MC19*Y19 + OH20_32*MC20*Y20 + OH21_32*MC21*Y21 + OH22_32*MC22*Y22 + OH23_32*MC23*Y23 + OH24_32*MC24*Y24 + OH25_32*MC25*Y25 + OH26_32*MC26*Y26 + OH27_32*MC27*Y27 + OH28_32*MC28*Y28 + OH29_32*MC29*Y29 + OH30_32*MC30*Y30 + OH31_32*MC31*Y31 + OH32_32*MC32*Y32 + OH33_32*MC33*Y33)/P32 + BH32*PH*EX/P32;
Y33 = BH33*PH*CH/P33 + (OH1_33*MC1*Y1 + OH2_33*MC2*Y2 + OH3_33*MC3*Y3 + OH4_33*MC4*Y4 + OH5_33*MC5*Y5 + OH6_33*MC6*Y6 + OH7_33*MC7*Y7 + OH8_33*MC8*Y8 + OH9_33*MC9*Y9 + OH10_33*MC10*Y10 + OH11_33*MC11*Y11 + OH12_33*MC12*Y12 + OH13_33*MC13*Y13 + OH14_33*MC14*Y14 + OH15_33*MC15*Y15 + OH16_33*MC16*Y16 + OH17_33*MC17*Y17 + OH18_33*MC18*Y18 + OH19_33*MC19*Y19 + OH20_33*MC20*Y20 + OH21_33*MC21*Y21 + OH22_33*MC22*Y22 + OH23_33*MC23*Y23 + OH24_33*MC24*Y24 + OH25_33*MC25*Y25 + OH26_33*MC26*Y26 + OH27_33*MC27*Y27 + OH28_33*MC28*Y28 + OH29_33*MC29*Y29 + OH30_33*MC30*Y30 + OH31_33*MC31*Y31 + OH32_33*MC32*Y32 + OH33_33*MC33*Y33)/P33 + BH33*PH*EX/P33;
//------------------------------------------------------------
// [5] Consumption aggregation: Cobb-Douglas domestic bundle,
//     CES nest between domestic (H) and imported (F) bundles
//------------------------------------------------------------
PH = P1^BH1 * P2^BH2 * P3^BH3 * P4^BH4 * P5^BH5 * P6^BH6 * P7^BH7 * P8^BH8 * P9^BH9 * P10^BH10 * P11^BH11 * P12^BH12 * P13^BH13 * P14^BH14 * P15^BH15 * P16^BH16 * P17^BH17 * P18^BH18 * P19^BH19 * P20^BH20 * P21^BH21 * P22^BH22 * P23^BH23 * P24^BH24 * P25^BH25 * P26^BH26 * P27^BH27 * P28^BH28 * P29^BH29 * P30^BH30 * P31^BH31 * P32^BH32 * P33^BH33;
PC = ( OMEGA*PH^(1-ETA) + (1-OMEGA)*PFH^(1-ETA) )^(1/(1-ETA));
CH = OMEGA*(PH/PC)^(-ETA)*C;
CF = (1-OMEGA)*(PFH/PC)^(-ETA)*C;
PIC = PC/PC(-1);
//------------------------------------------------------------
// [6] Household Euler equation and labour supply (nonlinear CRRA/Frisch)
//------------------------------------------------------------
C^(-GAMMA) = BETA*I*(C(+1)^(-GAMMA))/PIC(+1);
W/PC = C^GAMMA * Ltot^VARPHI;
//------------------------------------------------------------
// [7] Exchange rate block: LOP for imports, UIP with debt-elastic premium
//------------------------------------------------------------
PFH = S*PF;
I = ISTAR*(1 - PSI*(BSTAR - BSTARBAR)) * RP * S(+1)/S;
//------------------------------------------------------------
// [8] Net foreign assets: current-account identity
//------------------------------------------------------------
BSTAR = (I(-1)/PIC)*BSTAR(-1) + (PH*EX - PFH*IM)/PC;
//------------------------------------------------------------
// [9] Export demand and total import demand
//------------------------------------------------------------
EX = KAPEX_SCALE*DSTAR*PX*(PH/PFH)^(-THETA_S);
IM = CF + OF1*MC1*Y1/PFH + OF2*MC2*Y2/PFH + OF3*MC3*Y3/PFH + OF4*MC4*Y4/PFH + OF5*MC5*Y5/PFH + OF6*MC6*Y6/PFH + OF7*MC7*Y7/PFH + OF8*MC8*Y8/PFH + OF9*MC9*Y9/PFH + OF10*MC10*Y10/PFH + OF11*MC11*Y11/PFH + OF12*MC12*Y12/PFH + OF13*MC13*Y13/PFH + OF14*MC14*Y14/PFH + OF15*MC15*Y15/PFH + OF16*MC16*Y16/PFH + OF17*MC17*Y17/PFH + OF18*MC18*Y18/PFH + OF19*MC19*Y19/PFH + OF20*MC20*Y20/PFH + OF21*MC21*Y21/PFH + OF22*MC22*Y22/PFH + OF23*MC23*Y23/PFH + OF24*MC24*Y24/PFH + OF25*MC25*Y25/PFH + OF26*MC26*Y26/PFH + OF27*MC27*Y27/PFH + OF28*MC28*Y28/PFH + OF29*MC29*Y29/PFH + OF30*MC30*Y30/PFH + OF31*MC31*Y31/PFH + OF32*MC32*Y32/PFH + OF33*MC33*Y33/PFH;
//------------------------------------------------------------
// [10] Policy rule (regime-dependent)
//------------------------------------------------------------
@#if REGIME == "float"
log(I/ISTAR) = PHI_PI*piDC + PHI_Y*y_gap;
@#elseif REGIME == "peg"
S = 1;
@#elseif REGIME == "managed"
log(I/ISTAR) = PHI_PI*piDC + PHI_Y*y_gap + PHI_S*log(S);
@#elseif REGIME == "cpi_it"
log(I/ISTAR) = PHI_PI*log(PIC) + PHI_Y*y_gap;
@#elseif REGIME == "ppi_it"
log(I/ISTAR) = PHI_PI*log(PH/PH(-1)) + PHI_Y*y_gap;
@#endif
//------------------------------------------------------------
// [11] DC inflation index and output gap
//------------------------------------------------------------
piDC = WDC1*log(PI1) + WDC2*log(PI2) + WDC3*log(PI3) + WDC4*log(PI4) + WDC5*log(PI5) + WDC6*log(PI6) + WDC7*log(PI7) + WDC8*log(PI8) + WDC9*log(PI9) + WDC10*log(PI10) + WDC11*log(PI11) + WDC12*log(PI12) + WDC13*log(PI13) + WDC14*log(PI14) + WDC15*log(PI15) + WDC16*log(PI16) + WDC17*log(PI17) + WDC18*log(PI18) + WDC19*log(PI19) + WDC20*log(PI20) + WDC21*log(PI21) + WDC22*log(PI22) + WDC23*log(PI23) + WDC24*log(PI24) + WDC25*log(PI25) + WDC26*log(PI26) + WDC27*log(PI27) + WDC28*log(PI28) + WDC29*log(PI29) + WDC30*log(PI30) + WDC31*log(PI31) + WDC32*log(PI32) + WDC33*log(PI33);
y_gap1 = LAMBDA_D1*(log(Y1/STEADY_STATE(Y1)) - log(A1));
y_gap2 = LAMBDA_D2*(log(Y2/STEADY_STATE(Y2)) - log(A2));
y_gap3 = LAMBDA_D3*(log(Y3/STEADY_STATE(Y3)) - log(A3));
y_gap4 = LAMBDA_D4*(log(Y4/STEADY_STATE(Y4)) - log(A4));
y_gap5 = LAMBDA_D5*(log(Y5/STEADY_STATE(Y5)) - log(A5));
y_gap6 = LAMBDA_D6*(log(Y6/STEADY_STATE(Y6)) - log(A6));
y_gap7 = LAMBDA_D7*(log(Y7/STEADY_STATE(Y7)) - log(A7));
y_gap8 = LAMBDA_D8*(log(Y8/STEADY_STATE(Y8)) - log(A8));
y_gap9 = LAMBDA_D9*(log(Y9/STEADY_STATE(Y9)) - log(A9));
y_gap10 = LAMBDA_D10*(log(Y10/STEADY_STATE(Y10)) - log(A10));
y_gap11 = LAMBDA_D11*(log(Y11/STEADY_STATE(Y11)) - log(A11));
y_gap12 = LAMBDA_D12*(log(Y12/STEADY_STATE(Y12)) - log(A12));
y_gap13 = LAMBDA_D13*(log(Y13/STEADY_STATE(Y13)) - log(A13));
y_gap14 = LAMBDA_D14*(log(Y14/STEADY_STATE(Y14)) - log(A14));
y_gap15 = LAMBDA_D15*(log(Y15/STEADY_STATE(Y15)) - log(A15));
y_gap16 = LAMBDA_D16*(log(Y16/STEADY_STATE(Y16)) - log(A16));
y_gap17 = LAMBDA_D17*(log(Y17/STEADY_STATE(Y17)) - log(A17));
y_gap18 = LAMBDA_D18*(log(Y18/STEADY_STATE(Y18)) - log(A18));
y_gap19 = LAMBDA_D19*(log(Y19/STEADY_STATE(Y19)) - log(A19));
y_gap20 = LAMBDA_D20*(log(Y20/STEADY_STATE(Y20)) - log(A20));
y_gap21 = LAMBDA_D21*(log(Y21/STEADY_STATE(Y21)) - log(A21));
y_gap22 = LAMBDA_D22*(log(Y22/STEADY_STATE(Y22)) - log(A22));
y_gap23 = LAMBDA_D23*(log(Y23/STEADY_STATE(Y23)) - log(A23));
y_gap24 = LAMBDA_D24*(log(Y24/STEADY_STATE(Y24)) - log(A24));
y_gap25 = LAMBDA_D25*(log(Y25/STEADY_STATE(Y25)) - log(A25));
